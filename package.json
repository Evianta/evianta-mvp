{
  "name": "evianta-mvp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "24.3.0"
  },
  "scripts": {
    "dev": "pnpm dev:prepare && concurrently --kill-others --names packages,api-build,api,worker,web \"pnpm watch:packages\" \"pnpm --filter @evianta/api watch\" \"pnpm --filter @evianta/api dev:server\" \"pnpm --filter @evianta/api dev:worker:server\" \"pnpm --filter @evianta/web dev:server\"",
    "dev:prepare": "pnpm --filter @evianta/api build",
    "dev:web": "pnpm --filter @evianta/web dev",
    "dev:api": "pnpm --filter @evianta/api dev",
    "dev:worker": "pnpm --filter @evianta/api dev:worker",
    "watch:packages": "pnpm --parallel --filter \"@evianta/*\" --filter \"!@evianta/api\" --filter \"!@evianta/web\" watch",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.tooling.json && tsc --noEmit -p apps/web/tsconfig.tooling.json",
    "test": "pnpm -r build && vitest run",
    "test:e2e": "pnpm --filter @evianta/web test:e2e",
    "build": "pnpm -r build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@next/eslint-plugin-next": "15.5.28",
    "@types/node": "24.3.0",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
