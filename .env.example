NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=evianta
JWT_SIGNING_KEY=
JWT_ISSUER=evianta
JWT_AUDIENCE=evianta-api
JWT_TTL_SECONDS=1800
# Between 1800 and 28800. Longer sessions suit evaluators watching a demo.
# Separate secret (32+ bytes) that enables memorable passphrase access keys.
# ACCESS_KEY_PEPPER=
WEB_ORIGIN=http://localhost:3000
API_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
AUTH_RATE_LIMIT_PER_MINUTE=20
API_RATE_LIMIT_PER_MINUTE=120
SESSION_RECHECK_SECONDS=30
TRUST_PROXY_HOPS=0
EVIANTA_AI_PROVIDER=mock
# Test mode is permitted only with the mock provider. Use enforced with Muse.
EVIANTA_USAGE_MODE=test
# Required when EVIANTA_USAGE_MODE=enforced.
# MODEL_MAX_INPUT_TOKENS=32000
# MODEL_MAX_OUTPUT_TOKENS=2048
# USER_MAX_CONCURRENT_RUNS=2
# GLOBAL_MAX_CONCURRENT_RUNS=10
# USER_SPEND_LIMIT_USD=5.25
# GLOBAL_SPEND_LIMIT_USD=100
# SPEND_PERIOD_SECONDS=86400
DOCUMENT_STORE=filesystem
LOCAL_STORAGE_DIR=.data/documents
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_FILES=10
DOCUMENT_MAX_PAGES=100
# S3_DOWNLOAD_TTL_SECONDS=300
# Required only when EVIANTA_AI_PROVIDER=muse. Never expose these to the browser.
# MODEL_API_KEY=
# MUSE_BASE_URL=https://api.meta.ai/v1
# MUSE_SPARK_MODEL=
# MUSE_WONDER_MODEL=
