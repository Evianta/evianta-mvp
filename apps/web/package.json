{
  "name": "@evianta/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@evianta/core": "workspace:*",
    "@formkit/auto-animate": "^0.10.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "10.1.0",
    "framer-motion": "^14.5.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "pdfmake": "0.3.13",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "scripts": {
    "predev": "pnpm --filter @evianta/core build",
    "dev": "concurrently --kill-others --names core,web \"pnpm --filter @evianta/core watch\" \"pnpm dev:server\"",
    "dev:server": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev",
    "pretypecheck": "pnpm --filter @evianta/core build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @evianta/core build",
    "test": "vitest run --passWithNoTests",
    "pretest:e2e": "pnpm --filter @evianta/core build",
    "test:e2e": "playwright test",
    "prebuild": "pnpm --filter @evianta/core build",
    "build": "cross-env NODE_ENV=production node --env-file-if-exists=../../.env node_modules/next/dist/bin/next build",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=../../.env node_modules/next/dist/bin/next start"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/pdfmake": "0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "pdfjs-dist": "6.4.299",
    "tailwindcss": "^3.4.19"
  }
}
